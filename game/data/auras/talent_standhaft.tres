[gd_resource type="Resource" script_class="AuraData" format=3]

[ext_resource type="Script" path="res://scripts/combat/aura_data.gd" id="x1"]
[ext_resource type="Script" path="res://scripts/combat/proc_data.gd" id="x2"]
[ext_resource type="Script" path="res://scripts/combat/effect_data.gd" id="x3"]
[ext_resource type="Script" path="res://scripts/combat/effects/percent_heal_effect.gd" id="x4"]
[ext_resource type="Resource" path="res://data/abilities/bollwerk_haltung.tres" id="x5"]
[ext_resource type="Script" path="res://scripts/combat/effect_scaling.gd" id="x6"]

[sub_resource type="Resource" id="R1"]
script = ExtResource("x6")
kind = 1
aura_id = &"talent_standhaft"
own_aura_only = true

[sub_resource type="Resource" id="R2"]
script = ExtResource("x4")
target_mode = 1
percent_key = "werte.heilung_je_block"
values_ability = ExtResource("x5")
scaling = Array[ExtResource("x6")]([SubResource("R1")])

[sub_resource type="Resource" id="R3"]
script = ExtResource("x2")
event = 5
effects = Array[ExtResource("x3")]([SubResource("R2")])

[resource]
script = ExtResource("x1")
id = &"talent_standhaft"
display_name = "Standhaft"
description = "Talent: Jeder Block heilt 1/2/3 % des maximalen Lebens."
hidden = true
cancelable = false
max_stacks = 3
procs = Array[ExtResource("x2")]([SubResource("R3")])
