[gd_resource type="Resource" script_class="AuraData" format=3]

[ext_resource type="Script" path="res://scripts/combat/aura_data.gd" id="x1"]
[ext_resource type="Script" path="res://scripts/combat/amount_modifier_data.gd" id="x2"]
[ext_resource type="Script" path="res://scripts/combat/proc_data.gd" id="x3"]
[ext_resource type="Script" path="res://scripts/combat/effect_data.gd" id="x4"]
[ext_resource type="Script" path="res://scripts/combat/effects/mage/mage_aura_effect.gd" id="x5"]
[ext_resource type="Resource" path="res://data/abilities/rache.tres" id="x6"]
[ext_resource type="Script" path="res://scripts/combat/effects/resource_effect.gd" id="x7"]
[ext_resource type="Resource" path="res://data/abilities/bollwerk_haltung.tres" id="x8"]

[sub_resource type="Resource" id="R1"]
script = ExtResource("x2")
kind = 4
percent = 200.0

[sub_resource type="Resource" id="R2"]
script = ExtResource("x2")
kind = 1
percent = -10.0

[sub_resource type="Resource" id="R3"]
script = ExtResource("x5")
aura_id = &"rache"
target_mode = 1
duration_ability = ExtResource("x6")
duration_key = "dauer"

[sub_resource type="Resource" id="R4"]
script = ExtResource("x3")
event = 3
effects = Array[ExtResource("x4")]([SubResource("R3")])

[sub_resource type="Resource" id="R5"]
script = ExtResource("x3")
event = 4
effects = Array[ExtResource("x4")]([SubResource("R3")])

[sub_resource type="Resource" id="R6"]
script = ExtResource("x7")
resource = &"rage"
amount_key = "werte.wut_je_block"
target_mode = 1
values_ability = ExtResource("x8")

[sub_resource type="Resource" id="R7"]
script = ExtResource("x3")
event = 5
effects = Array[ExtResource("x4")]([SubResource("R3"), SubResource("R6")])

[resource]
script = ExtResource("x1")
id = &"bollwerk_haltung"
display_name = "Bollwerk-Haltung"
description = "Dreifache Bedrohung, 10 % weniger erlittener Schaden. Nach Ausweichen, Parieren oder Blocken: Rache. Jeder Block erzeugt 5 Wut."
ability_id = &"bollwerk_haltung"
cancelable = false
amount_modifiers = Array[ExtResource("x2")]([SubResource("R1"), SubResource("R2")])
procs = Array[ExtResource("x3")]([SubResource("R4"), SubResource("R5"), SubResource("R7")])
