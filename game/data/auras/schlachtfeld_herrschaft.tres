[gd_resource type="Resource" script_class="AuraData" format=3]

[ext_resource type="Script" path="res://scripts/combat/aura_data.gd" id="x1"]
[ext_resource type="Script" path="res://scripts/combat/proc_data.gd" id="x2"]
[ext_resource type="Script" path="res://scripts/combat/effect_data.gd" id="x3"]
[ext_resource type="Script" path="res://scripts/combat/effects/mage/mage_aura_effect.gd" id="x4"]
[ext_resource type="Resource" path="res://data/abilities/tiefe_wunde.tres" id="x5"]

[sub_resource type="Resource" id="R1"]
script = ExtResource("x4")
aura_id = &"tiefe_wunde"
target_mode = 0
duration_ability = ExtResource("x5")
