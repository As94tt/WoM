[resource]
script = ExtResource("x1")
id = &"warrior"
icon = ExtResource("x2")
display_name = "Krieger"
description = "Nahkämpfer in Platte und erste Tank-Klasse. Baut im Kampf Wut auf und gibt sie für starke Schläge aus; zieht Bedrohung auf sich, spottet, blockt und pariert. Ressource: Wut."
role = 1
role_name = "Tank"
color = Color(0.75, 0.55, 0.35, 1)
order = 2
primary_attribute = &"strength"
power_stat = &"attack_power"
resources = Array[StringName]([&"rage"])
abilities = Array[ExtResource("x3")]([ExtResource("x4"), ExtResource("x5"), ExtResource("x6"), ExtResource("x7"), ExtResource("x8"), ExtResource("x9"), ExtResource("x10"), ExtResource("x11")])
specializations = Array[ExtResource("x12")]([ExtResource("x13"), ExtResource("x14"), ExtResource("x15"), ExtResource("x16"), ExtResource("x17"), ExtResource("x18")])
