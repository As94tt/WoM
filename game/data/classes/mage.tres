[resource]
script = ExtResource("1_class")
id = &"mage"
icon = ExtResource("icon_55")
display_name = "Magier"
description = "Fernkampf-Zauberwirker in Stoff: hoher Schaden, wenig Rüstung. Überlebt durch Schild, Schritt und Fessel. Ressource: Mana."
role_name = "Schaden"
color = Color(0.35, 0.6, 1, 1)
order = 1
primary_attribute = &"intellect"
power_stat = &"spell_power"
resources = Array[StringName]([&"mana"])
abilities = Array[ExtResource("ability_script")]([ExtResource("2_7i70b"), ExtResource("3_b4jg5"), ExtResource("4_srxku"), ExtResource("5_wtygw"), ExtResource("6_ttxsn"), ExtResource("7_4clds"), ExtResource("8_6eowd")])
