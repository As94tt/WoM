[gd_resource type="Resource" script_class="ClassData" format=3]

[ext_resource type="Script" path="res://scripts/data/class_data.gd" id="1_class"]
[ext_resource type="Script" path="res://scripts/data/ability_data.gd" id="ability_script"]
[ext_resource type="Resource" path="res://data/abilities/feuerball.tres" id="2_feuerball"]
[ext_resource type="Resource" path="res://data/abilities/frostnova.tres" id="3_frostnova"]
[ext_resource type="Resource" path="res://data/abilities/passiv_magier.tres" id="4_passiv_magier"]
[ext_resource type="Resource" path="res://data/abilities/gegenzauber.tres" id="5_gegenzauber"]

[resource]
script = ExtResource("1_class")
id = &"mage"
display_name = "Magier"
description = "Fernkampf-Schaden mit Mana. Wirkt Zauber mit Zauberzeit, Projektile, Flächenschaden und Kontrolle."
role = 0
role_name = "Schaden"
color = Color(0.35, 0.6, 1, 1)
order = 1
primary_attribute = &"intellect"
power_stat = &"spell_power"
resources = Array[StringName]([&"mana"])
abilities = Array[ExtResource("ability_script")]([ExtResource("2_feuerball"), ExtResource("3_frostnova"), ExtResource("4_passiv_magier"), ExtResource("5_gegenzauber")])
