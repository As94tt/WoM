[gd_resource type="Resource" script_class="TableSchema" format=3]

[ext_resource type="Script" path="res://scripts/data/tables/column_schema.gd" id="1_upcol"]
[ext_resource type="Script" path="res://scripts/data/tables/table_schema.gd" id="2_uptab"]

[sub_resource type="Resource" id="Resource_up_id"]
script = ExtResource("1_upcol")
name = "id"
type = 1
required = true
choices = PackedStringArray()
description = "Feste ID, wird nie geändert (z. B. schadenspuppe_10). Die Aufstellpunkte im Trainingsbereich verweisen darauf."

[sub_resource type="Resource" id="Resource_up_name"]
script = ExtResource("1_upcol")
name = "name"
required = true
choices = PackedStringArray()
description = "Anzeigename (Rahmen, Namensplakette)."

[sub_resource type="Resource" id="Resource_up_art"]
script = ExtResource("1_upcol")
name = "art"
type = 5
required = true
choices = PackedStringArray("schaden", "heilung", "angriff")
description = "schaden: zeigt Schaden pro Sekunde und Gesamtschaden, stirbt nie. heilung: verliert regelmäßig Leben, zeigt Heilung pro Sekunde und Überheilung. angriff (#35): wie schaden, greift aber den Spieler mit der höchsten Bedrohung in Nahkampfreichweite an (angriff_schaden, angriff_takt)."

[sub_resource type="Resource" id="Resource_up_gesinnung"]
script = ExtResource("1_upcol")
name = "gesinnung"
type = 5
default_value = "feindlich"
choices = PackedStringArray("feindlich", "neutral", "freundlich")
description = "Gesinnung gegenüber Spielern."

[sub_resource type="Resource" id="Resource_up_stufe"]
script = ExtResource("1_upcol")
name = "stufe"
type = 2
required = true
has_min = true
min_value = 1.0
has_max = true
max_value = 100.0
choices = PackedStringArray()
description = "Stufe der Puppe (im Entwickler-Panel zur Laufzeit änderbar)."

[sub_resource type="Resource" id="Resource_up_rang"]
script = ExtResource("1_upcol")
name = "rang"
type = 5
default_value = "normal"
choices = PackedStringArray("normal", "elite", "selten", "boss")
description = "Rang für die Kennzeichnung am Zielrahmen (wie bei Gegnern)."

[sub_resource type="Resource" id="Resource_up_leben"]
script = ExtResource("1_upcol")
name = "leben"
type = 2
required = true
has_min = true
min_value = 1.0
choices = PackedStringArray()
description = "Maximales Leben (fester Grundwert, ersetzt die Formel des Wertesystems)."

[sub_resource type="Resource" id="Resource_up_verlust"]
script = ExtResource("1_upcol")
name = "verlust_prozent"
type = 3
default_value = "0"
has_min = true
has_max = true
max_value = 100.0
choices = PackedStringArray()
description = "Nur Heilpuppe: Lebensverlust je Intervall in Prozent des maximalen Lebens (0 = kein Verlust)."

[sub_resource type="Resource" id="Resource_up_intervall"]
script = ExtResource("1_upcol")
name = "verlust_intervall"
type = 3
default_value = "1"
has_min = true
min_value = 0.1
has_max = true
max_value = 60.0
choices = PackedStringArray()
description = "Nur Heilpuppe: Sekunden zwischen zwei Lebensverlusten."

[sub_resource type="Resource" id="Resource_up_immun"]
script = ExtResource("1_upcol")
name = "immunitaeten"
type = 7
choices = PackedStringArray()
item_type = 1
description = "Zustände oder Schadensschulen, gegen die die Puppe immun ist (#32), z. B. betaeubung|feuer. Zustände: betaeubung, festhalten, verlangsamung, stille, umwerfen, tarnung, unverwundbarkeit; Schulen: IDs aus schadensschulen.csv."

[sub_resource type="Resource" id="Resource_up_ruestung"]
script = ExtResource("1_upcol")
name = "ruestung"
type = 3
has_min = true
choices = PackedStringArray()
description = "Rüstung (#34, mindert körperlichen Schaden). Leer = Wertesystem (0)."

[sub_resource type="Resource" id="Resource_up_zauberschutz"]
script = ExtResource("1_upcol")
name = "zauberschutz"
type = 3
has_min = true
choices = PackedStringArray()
description = "Zauberschutz (#34, mindert magischen Schaden). Leer = Wertesystem (0)."

[sub_resource type="Resource" id="Resource_up_ausweichen"]
script = ExtResource("1_upcol")
name = "ausweichen"
type = 3
has_min = true
has_max = true
max_value = 100.0
choices = PackedStringArray()
description = "Ausweichchance in Prozent (#34). Leer = Wertesystem (ausweichen_grund)."

[sub_resource type="Resource" id="Resource_up_parieren"]
script = ExtResource("1_upcol")
name = "parieren"
type = 3
has_min = true
has_max = true
max_value = 100.0
choices = PackedStringArray()
description = "Parierchance in Prozent (#34, nur Nahkampf von vorne). Leer = Wertesystem (ohne Nahkampfwaffe 0)."

[sub_resource type="Resource" id="Resource_up_blocken"]
script = ExtResource("1_upcol")
name = "blocken"
type = 3
has_min = true
has_max = true
max_value = 100.0
choices = PackedStringArray()
description = "Blockchance in Prozent (#34, nur Nah- und Fernkampf von vorne). Leer = Wertesystem (ohne Schild 0)."

[sub_resource type="Resource" id="Resource_up_blockwert"]
script = ExtResource("1_upcol")
name = "blockwert"
type = 3
has_min = true
choices = PackedStringArray()
description = "Schaden, den ein Block abfängt (#34). Leer = Wertesystem (ohne Schild 0)."

[sub_resource type="Resource" id="Resource_up_angriff_schaden"]
script = ExtResource("1_upcol")
name = "angriff_schaden"
type = 3
default_value = "0"
has_min = true
choices = PackedStringArray()
description = "Nur Angriffspuppe (#35): fester Schaden je Schlag (körperlich, Nahkampfwurf: Ausweichen, Parieren, Blocken und Rüstung des Spielers wirken)."

[sub_resource type="Resource" id="Resource_up_angriff_takt"]
script = ExtResource("1_upcol")
name = "angriff_takt"
type = 3
default_value = "2"
has_min = true
min_value = 0.1
has_max = true
max_value = 60.0
choices = PackedStringArray()
description = "Nur Angriffspuppe (#35): Sekunden zwischen zwei Schlägen."

[resource]
script = ExtResource("2_uptab")
table = "uebungspuppen"
title = "Übungspuppen"
group = "Gegner"
description = "Übungspuppen im Trainingsbereich (#31). Eine Zeile pro Puppentyp; aufgestellt werden sie über Aufstellpunkte (UnitSpawnPoint) in der Szene des Trainingsgeländes. Anzeigefenster und Rücksetzzeit stehen in spielkonstanten.csv."
key_columns = PackedStringArray("id")
order = 15
columns = Array[ExtResource("1_upcol")]([SubResource("Resource_up_id"), SubResource("Resource_up_name"), SubResource("Resource_up_art"), SubResource("Resource_up_gesinnung"), SubResource("Resource_up_stufe"), SubResource("Resource_up_rang"), SubResource("Resource_up_leben"), SubResource("Resource_up_verlust"), SubResource("Resource_up_intervall"), SubResource("Resource_up_immun"), SubResource("Resource_up_ruestung"), SubResource("Resource_up_zauberschutz"), SubResource("Resource_up_ausweichen"), SubResource("Resource_up_parieren"), SubResource("Resource_up_blocken"), SubResource("Resource_up_blockwert"), SubResource("Resource_up_angriff_schaden"), SubResource("Resource_up_angriff_takt")])
