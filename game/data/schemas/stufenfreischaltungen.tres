[gd_resource type="Resource" script_class="TableSchema" format=3]

[ext_resource type="Script" path="res://scripts/data/tables/column_schema.gd" id="1_sf27c"]
[ext_resource type="Script" path="res://scripts/data/tables/table_schema.gd" id="2_sf27t"]

[sub_resource type="Resource" id="Resource_sf_id"]
script = ExtResource("1_sf27c")
name = "id"
type = 1
required = true
choices = PackedStringArray()
description = "Eindeutige ID der Freischaltung (z. B. „reittier“). Andere Systeme fragen sie mit LevelUpSummary.has_unlock ab."

[sub_resource type="Resource" id="Resource_sf_klasse"]
script = ExtResource("1_sf27c")
name = "klasse"
type = 6
choices = PackedStringArray()
ref_folder = "res://data/classes/"
ref_label = "Klasse"
description = "Nur für diese Klasse (ID wie in res://data/classes/); leer = für alle Klassen."

[sub_resource type="Resource" id="Resource_sf_stufe"]
script = ExtResource("1_sf27c")
name = "stufe"
type = 2
required = true
has_min = true
min_value = 2.0
has_max = true
max_value = 100.0
choices = PackedStringArray()
description = "Stufe, ab der die Freischaltung gilt."

[sub_resource type="Resource" id="Resource_sf_text"]
script = ExtResource("1_sf27c")
name = "text"
type = 0
required = true
choices = PackedStringArray()
description = "Zeile in der Aufstiegsmeldung, z. B. „Du kannst jetzt reiten.“"

[sub_resource type="Resource" id="Resource_sf_fenster"]
script = ExtResource("1_sf27c")
name = "fenster"
type = 5
choices = PackedStringArray("character", "spellbook", "talents", "map", "bags")
description = "Fenster, das ein Klick auf die Zeile öffnet (leer = keins)."

[resource]
script = ExtResource("2_sf27t")
table = "stufenfreischaltungen"
title = "Weitere Freischaltungen je Stufe"
group = "Charaktere"
description = "Was eine Stufe außer Werten, Fähigkeiten (Feld required_level der Fähigkeit), Spezialisierung und Talentpunkten (spielkonstanten.csv) noch freischaltet, z. B. später ein Reittier oder eine neue Funktion. Erscheint in der Aufstiegsmeldung; abfragbar über LevelUpSummary.has_unlock. Neue Freischaltungen brauchen keine Code-Änderung."
key_columns = PackedStringArray("id")
order = 53
columns = Array[ExtResource("1_sf27c")]([SubResource("Resource_sf_id"), SubResource("Resource_sf_klasse"), SubResource("Resource_sf_stufe"), SubResource("Resource_sf_text"), SubResource("Resource_sf_fenster")])
