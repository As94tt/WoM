[gd_resource type="Resource" script_class="AbilityData" format=3]

[ext_resource type="Script" path="res://scripts/data/ability_data.gd" id="1_ability"]
[ext_resource type="Script" path="res://scripts/combat/effect_data.gd" id="2_effect"]
[ext_resource type="Script" path="res://scripts/combat/effects/threat_effect.gd" id="3_threat"]

[sub_resource type="Resource" id="Resource_reset"]
script = ExtResource("3_threat")
mode = 2
target_mode = 2
filter = 2
radius_from_ability = true

[resource]
script = ExtResource("1_ability")
id = &"test_totstellen"
display_name = "Testtotstellen"
description = "Setzt Eure Bedrohung bei allen Feinden in der Nähe zurück; sie wählen ein neues Ziel (wie Totstellen)."
dev_only = true
effects = Array[ExtResource("2_effect")]([SubResource("Resource_reset")])
target_kind = 0
ignores_gcd = true
highlight_auras = PackedStringArray()
