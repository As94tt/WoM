[gd_resource type="Resource" script_class="AbilityData" format=3]

[ext_resource type="Script" path="res://scripts/data/ability_data.gd" id="1_ability"]
[ext_resource type="Script" path="res://scripts/combat/effect_data.gd" id="2_effect"]
[ext_resource type="Script" path="res://scripts/combat/effects/damage_effect.gd" id="3_damage"]
[ext_resource type="Script" path="res://scripts/combat/effects/projectile_effect.gd" id="4_projectile"]
[ext_resource type="Script" path="res://scripts/combat/effects/apply_aura_effect.gd" id="5_apply"]
[ext_resource type="Resource" path="res://data/auras/brand.tres" id="6_brand"]

[sub_resource type="Resource" id="Resource_damage"]
script = ExtResource("3_damage")
school = &"feuer"
values_from_ability = true

[sub_resource type="Resource" id="Resource_aura"]
script = ExtResource("5_apply")
aura = ExtResource("6_brand")

[sub_resource type="Resource" id="Resource_projectile"]
script = ExtResource("4_projectile")
speed_from_ability = true
effects = Array[ExtResource("2_effect")]([SubResource("Resource_damage"), SubResource("Resource_aura")])

[resource]
script = ExtResource("1_ability")
id = &"glutball"
display_name = "Glutball"
description = "Variante von Feuerball (Spezialisierung Feuer, Testdaten #20): schnellerer, heißerer Feuerball; das Ziel brennt nach."
class_id = &"mage"
required_level = 1
is_spell = true
school = &"feuer"
effects = Array[ExtResource("2_effect")]([SubResource("Resource_projectile")])
highlight_auras = PackedStringArray()
