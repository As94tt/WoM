[ext_resource type="Script" path="res://scripts/combat/effect_data.gd" id="2_effect"]
[ext_resource type="Script" path="res://scripts/combat/effects/threat_effect.gd" id="3_threat"]

[sub_resource type="Resource" id="Resource_taunt"]
