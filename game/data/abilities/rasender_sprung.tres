[gd_resource type="Resource" script_class="AbilityData" format=3]

[ext_resource type="Script" path="res://scripts/data/ability_data.gd" id="x1"]
[ext_resource type="Script" path="res://scripts/combat/effect_data.gd" id="x2"]
[ext_resource type="Script" path="res://scripts/combat/effects/movement_effect.gd" id="x3"]
[ext_resource type="Script" path="res://scripts/combat/effects/strike_effect.gd" id="x4"]

[sub_resource type="Resource" id="R1"]
script = ExtResource("x3")
kind = 0

[sub_resource type="Resource" id="R2"]
script = ExtResource("x4")
school = &"physisch"
values_from_ability = true
target_mode = 3
filter = 2
radius_from_ability = true

[resource]
script = ExtResource("x1")
id = &"rasender_sprung"
display_name = "Rasender Sprung"
description = "Springt zu einem Ziel in bis zu 25 m und verursacht beim Aufprall Schaden an allen Gegnern im Umkreis."
class_id = &"warrior"
required_level = 10
school = &"physisch"
effects = Array[ExtResource("x2")]([SubResource("R1"), SubResource("R2")])
starts_auto_attack = true
