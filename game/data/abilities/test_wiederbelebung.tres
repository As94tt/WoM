[sub_resource type="Resource" id="Resource_resurrect"]
script = ExtResource("3_resurrect")

[resource]
script = ExtResource("1_ability")
id = &"test_wiederbelebung"
display_name = "Testwiederbelebung"
description = "Zauberzeit: Belebt einen toten Mitspieler wieder (er muss annehmen), auch im Kampf. Steht für Wiederbelebungsfähigkeiten wie die Wiedergeburt des Druiden."
dev_only = true
is_spell = true
school = &"natur"
effects = Array[ExtResource("2_effect")]([SubResource("Resource_resurrect")])
target_kind = 2
requires_facing = false
targets_dead = true
highlight_auras = PackedStringArray()
