[gd_resource type="Resource" script_class="AbilityData" format=3]

[ext_resource type="Script" path="res://scripts/data/ability_data.gd" id="1_ability"]
[ext_resource type="Script" path="res://scripts/combat/effect_data.gd" id="2_effect"]
[ext_resource type="Script" path="res://scripts/combat/effects/resurrect_effect.gd" id="3_resurrect"]

[sub_resource type="Resource" id="Resource_resurrect"]
script = ExtResource("3_resurrect")

[resource]
script = ExtResource("1_ability")
id = &"aufhelfen"
display_name = "Aufhelfen"
description = "Taste F gedrückt halten: Einem gefallenen Mitspieler aufhelfen. Nur außerhalb des Kampfes; Bewegung oder Schaden brechen ab. Der Gefallene muss die Hilfe annehmen und steht mit 30 % Leben auf."
innate = true
effects = Array[ExtResource("2_effect")]([SubResource("Resource_resurrect")])
target_kind = 2
requires_facing = false
ignores_gcd = true
targets_dead = true
cancelled_by_damage = true
requires_out_of_combat = true
highlight_auras = PackedStringArray()
