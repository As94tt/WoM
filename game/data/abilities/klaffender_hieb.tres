[gd_resource type="Resource" script_class="AbilityData" format=3]

[ext_resource type="Script" path="res://scripts/data/ability_data.gd" id="x1"]
[ext_resource type="Script" path="res://scripts/combat/effect_data.gd" id="x2"]
[ext_resource type="Script" path="res://scripts/combat/effects/strike_effect.gd" id="x3"]
[ext_resource type="Script" path="res://scripts/combat/effects/mage/mage_aura_effect.gd" id="x4"]
[ext_resource type="Resource" path="res://data/abilities/tiefe_wunde.tres" id="x5"]
[ext_resource type="Script" path="res://scripts/combat/effects/resource_effect.gd" id="x6"]

[sub_resource type="Resource" id="R1"]
script = ExtResource("x4")
aura_id = &"tiefe_wunde"
target_mode = 0
duration_ability = ExtResource("x5")
duration_key = "dauer"

[sub_resource type="Resource" id="R2"]
script = ExtResource("x3")
school = &"physisch"
values_from_ability = true
on_hit_effects = Array[ExtResource("x2")]([SubResource("R1")])

[sub_resource type="Resource" id="R3"]
script = ExtResource("x6")
resource = &"rage"
amount_key = "werte.wut"
target_mode = 1

[resource]
script = ExtResource("x1")
id = &"klaffender_hieb"
display_name = "Klaffender Hieb"
description = "Ein Waffenschlag, der eine Tiefe Wunde reißt. Erzeugt 10 Wut."
class_id = &"warrior"
required_level = 1
school = &"physisch"
effects = Array[ExtResource("x2")]([SubResource("R2"), SubResource("R3")])
starts_auto_attack = true
