[sub_resource type="Resource" id="S9"]
script = ExtResource("e5")
ability_id = &"arkanschlag"
value_key = "kosten"
add = -10.0

[sub_resource type="Resource" id="S10"]
script = ExtResource("e6")
modifiers = Array[ExtResource("e5")]([SubResource("S9")])

[sub_resource type="Resource" id="S11"]
script = ExtResource("e3")
id = &"arkane_effizienz"
display_name = "Arkane Effizienz"
