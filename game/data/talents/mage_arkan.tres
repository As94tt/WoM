[ext_resource type="Resource" path="res://data/auras/talent_arkane_macht.tres" id="e11"]

[sub_resource type="Resource" id="S1"]
script = ExtResource("e3")
id = &"arkanschlag"
display_name = "Arkanschlag"
description = "Neue Fähigkeit: Arkanschlag."
grants_abilities = Array[ExtResource("e7")]([ExtResource("e9")])

[sub_resource type="Resource" id="S2"]
