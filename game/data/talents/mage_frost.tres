[gd_resource type="Resource" script_class="TalentTreeData" format=3]

[ext_resource type="Script" path="res://scripts/talents/talent_tree_data.gd" id="e1"]
[ext_resource type="Script" path="res://scripts/talents/talent_row_data.gd" id="e2"]
[ext_resource type="Script" path="res://scripts/talents/talent_data.gd" id="e3"]
[ext_resource type="Script" path="res://scripts/combat/effect_data.gd" id="e4"]
[ext_resource type="Script" path="res://scripts/combat/ability_modifier_data.gd" id="e5"]
[ext_resource type="Script" path="res://scripts/combat/effects/modify_ability_effect.gd" id="e6"]
[ext_resource type="Script" path="res://scripts/data/ability_data.gd" id="e7"]
[ext_resource type="Script" path="res://scripts/combat/aura_data.gd" id="e8"]
[ext_resource type="Resource" path="res://data/abilities/eislanze.tres" id="e9"]
[ext_resource type="Resource" path="res://data/auras/talent_kaeltepanzer.tres" id="e10"]
[ext_resource type="Resource" path="res://data/auras/talent_winterschlaf.tres" id="e11"]

[sub_resource type="Resource" id="S1"]
script = ExtResource("e3")
id = &"eislanze"
display_name = "Eislanze"
description = "Neue Fähigkeit: Eislanze."
grants_abilities = Array[ExtResource("e7")]([ExtResource("e9")])

[sub_resource type="Resource" id="S2"]
script = ExtResource("e3")
id = &"kaeltepanzer"
display_name = "Kältepanzer"
description = "Passiv: +200 Rüstung."
auras = Array[ExtResource("e8")]([ExtResource("e10")])

[sub_resource type="Resource" id="S3"]
script = ExtResource("e2")
kind = 0
required_points = 0
talents = Array[ExtResource("e3")]([SubResource("S1"), SubResource("S2")])

[sub_resource type="Resource" id="S4"]
script = ExtResource("e5")
ability_id = &"eiswelle"
value_key = "abklingzeit"
add = -2.0

[sub_resource type="Resource" id="S5"]
script = ExtResource("e6")
modifiers = Array[ExtResource("e5")]([SubResource("S4")])

[sub_resource type="Resource" id="S6"]
script = ExtResource("e3")
id = &"bitterkalt"
display_name = "Bitterkalt"
description = "Eiswelle hat je Rang 2 Sek. weniger Abklingzeit."
max_ranks = 3
effects = Array[ExtResource("e4")]([SubResource("S5")])

[sub_resource type="Resource" id="S7"]
script = ExtResource("e2")
kind = 1
required_points = 1
talents = Array[ExtResource("e3")]([SubResource("S6")])

[sub_resource type="Resource" id="S8"]
script = ExtResource("e5")
ability_id = &"feuerball"
replacement_id = &"frostblitz"

[sub_resource type="Resource" id="S9"]
script = ExtResource("e6")
modifiers = Array[ExtResource("e5")]([SubResource("S8")])

[sub_resource type="Resource" id="S10"]
script = ExtResource("e3")
id = &"frostblitz"
display_name = "Frostblitz"
description = "Ersetzt Feuerball durch Frostblitz."
effects = Array[ExtResource("e4")]([SubResource("S9")])

[sub_resource type="Resource" id="S11"]
script = ExtResource("e3")
id = &"winterschlaf"
display_name = "Winterschlaf"
description = "Passiv: +10 % erhaltene Heilung."
auras = Array[ExtResource("e8")]([ExtResource("e11")])

[sub_resource type="Resource" id="S12"]
script = ExtResource("e2")
kind = 0
required_points = 3
talents = Array[ExtResource("e3")]([SubResource("S10"), SubResource("S11")])

[resource]
script = ExtResource("e1")
rows = Array[ExtResource("e2")]([SubResource("S3"), SubResource("S7"), SubResource("S12")])
