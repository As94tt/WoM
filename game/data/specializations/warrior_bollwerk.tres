[resource]
script = ExtResource("x1")
id = &"warrior_bollwerk"
display_name = "Bollwerk"
description = "Tank mit Einhandwaffe und Schild: ruhig und reaktiv.
Bollwerk-Haltung: dreifache Bedrohung, 10 % weniger erlittener Schaden. Nach Ausweichen, Parieren oder Blocken ist für 5 s Vergeltung verfügbar (Rache); jeder Block erzeugt 5 Wut. Bevorzugt Abwehr und Ausdauer."
order = 1
preferred_stats = Array[StringName]([&"avoidance", &"stamina"])
transformations = Array[ExtResource("x2")]([SubResource("R1"), SubResource("R2"), SubResource("R3"), SubResource("R4"), SubResource("R5"), SubResource("R6"), SubResource("R7")])
talent_tree = ExtResource("x17")
auras = Array[ExtResource("x18")]([ExtResource("x19")])
