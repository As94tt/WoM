[resource]
script = ExtResource("x1")
id = &"warrior_schlachtmeister"
display_name = "Schlachtmeister"
description = "Langsamer Nahkampf-Schaden mit Zweihandwaffe: große Treffer und ein starkes Ende.
Tiefe Wunde: Blutung am Ziel (bis 3 Stapel, 12 s). Hinrichten nur gegen Ziele unter 20 % Leben, verbraucht bis zu 40 zusätzliche Wut für Bonusschaden. Bevorzugt Verheerung und Durchschlag."
order = 3
preferred_stats = Array[StringName]([&"devastation", &"penetration"])
transformations = Array[ExtResource("x2")]([SubResource("R1"), SubResource("R2"), SubResource("R3"), SubResource("R4"), SubResource("R5"), SubResource("R6"), SubResource("R7")])
talent_tree = ExtResource("x17")
