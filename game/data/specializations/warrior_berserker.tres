[resource]
script = ExtResource("x1")
id = &"warrior_berserker"
display_name = "Berserker"
description = "Schneller Nahkampf-Schaden mit Zweihandwaffe: Wut aufbauen, dann entfesseln.
Raserei: Jede ausgegebene 30 Wut gibt 1 Stapel (+3 % Tempo, bis 5, 10 s). Bei 5 Stapeln Blutrausch: 8 s lang kosten Fähigkeiten keine Wut, danach fallen alle Stapel ab. Bevorzugt Tempo und Präzision."
order = 2
preferred_stats = Array[StringName]([&"haste", &"precision"])
transformations = Array[ExtResource("x2")]([SubResource("R1"), SubResource("R2"), SubResource("R3"), SubResource("R4"), SubResource("R5"), SubResource("R6"), SubResource("R7")])
talent_tree = ExtResource("x17")
auras = Array[ExtResource("x18")]([ExtResource("x19")])
