[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/combat/ground_area.gd" id="1_area"]

[sub_resource type="StandardMaterial3D" id="Material_disc"]
transparency = 1
shading_mode = 0
albedo_color = Color(0.6, 0.6, 0.65, 0.35)

[sub_resource type="CylinderMesh" id="Mesh_disc"]
material = SubResource("Material_disc")
top_radius = 1.0
bottom_radius = 1.0
height = 0.05
radial_segments = 48
rings = 1

[sub_resource type="SceneReplicationConfig" id="Replication_area"]
properties/0/path = NodePath(".:position")
properties/0/spawn = true
properties/0/replication_mode = 0
properties/1/path = NodePath(".:radius")
properties/1/spawn = true
properties/1/replication_mode = 0
properties/2/path = NodePath(".:expires_at")
properties/2/spawn = true
properties/2/replication_mode = 0

[node name="GroundArea" type="Node3D"]
script = ExtResource("1_area")

[node name="Disc" type="MeshInstance3D" parent="."]
cast_shadow = 0
mesh = SubResource("Mesh_disc")

[node name="Sync" type="MultiplayerSynchronizer" parent="."]
root_path = NodePath("..")
replication_config = SubResource("Replication_area")
