[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/units/enemy.gd" id="1_enemy"]
[ext_resource type="Script" path="res://scripts/stats/character_stats.gd" id="2_stats"]
[ext_resource type="Script" path="res://scripts/combat/unit_combat.gd" id="3_combat"]
[ext_resource type="Script" path="res://scripts/combat/unit_caster.gd" id="4_caster"]

[sub_resource type="CapsuleShape3D" id="Shape_body"]
radius = 0.4
height = 1.8

[sub_resource type="CapsuleMesh" id="Mesh_body"]
radius = 0.4
height = 1.8

[sub_resource type="BoxMesh" id="Mesh_nose"]
size = Vector3(0.2, 0.2, 0.3)

[sub_resource type="SceneReplicationConfig" id="Replication_server"]
properties/0/path = NodePath(".:position")
properties/0/spawn = true
properties/0/replication_mode = 2
properties/1/path = NodePath(".:rotation")
properties/1/spawn = true
properties/1/replication_mode = 2
properties/2/path = NodePath(".:enemy_id")
properties/2/spawn = true
properties/2/replication_mode = 2
properties/3/path = NodePath(".:level")
properties/3/spawn = true
properties/3/replication_mode = 2

[sub_resource type="SceneReplicationConfig" id="Replication_stats"]
properties/0/path = NodePath("Stats:stat_state")
properties/0/spawn = true
properties/0/replication_mode = 2
properties/1/path = NodePath("Stats:health")
properties/1/spawn = true
properties/1/replication_mode = 2
properties/2/path = NodePath("Stats:max_health")
properties/2/spawn = true
properties/2/replication_mode = 2
properties/3/path = NodePath("Combat:aura_state")
properties/3/spawn = true
properties/3/replication_mode = 2
properties/4/path = NodePath("Combat:ability_mod_state")
properties/4/spawn = true
properties/4/replication_mode = 2
properties/5/path = NodePath("Combat:threat_state")
properties/5/spawn = true
properties/5/replication_mode = 2

[sub_resource type="SceneReplicationConfig" id="Replication_cast"]
properties/0/path = NodePath("Caster:cast_state")
properties/0/spawn = true
properties/0/replication_mode = 2
properties/1/path = NodePath("Caster:cast_end")
properties/1/spawn = true
properties/1/replication_mode = 2
properties/2/path = NodePath("Caster:cooldown_state")
properties/2/spawn = true
properties/2/replication_mode = 2
properties/3/path = NodePath("Caster:auto_attack_on")
properties/3/spawn = true
properties/3/replication_mode = 2

[node name="Enemy" type="CharacterBody3D"]
collision_layer = 2
collision_mask = 0
script = ExtResource("1_enemy")

[node name="Collision" type="CollisionShape3D" parent="."]
position = Vector3(0, 0.9, 0)
shape = SubResource("Shape_body")

[node name="Model" type="Node3D" parent="."]

[node name="Body" type="MeshInstance3D" parent="Model"]
position = Vector3(0, 0.9, 0)
mesh = SubResource("Mesh_body")

[node name="Nose" type="MeshInstance3D" parent="Model"]
position = Vector3(0, 1.45, -0.45)
mesh = SubResource("Mesh_nose")

[node name="Combat" type="Node" parent="."]
script = ExtResource("3_combat")

[node name="Stats" type="Node" parent="."]
script = ExtResource("2_stats")

[node name="ServerSync" type="MultiplayerSynchronizer" parent="."]
root_path = NodePath("..")
replication_config = SubResource("Replication_server")

[node name="StatsSync" type="MultiplayerSynchronizer" parent="."]
root_path = NodePath("..")
delta_interval = 0.1
replication_config = SubResource("Replication_stats")

[node name="Caster" type="Node" parent="."]
script = ExtResource("4_caster")

[node name="CastSync" type="MultiplayerSynchronizer" parent="."]
root_path = NodePath("..")
replication_config = SubResource("Replication_cast")
