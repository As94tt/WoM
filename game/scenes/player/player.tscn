[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/player/player_character.gd" id="1_player"]
[ext_resource type="Script" path="res://scripts/player/player_input.gd" id="2_input"]
[ext_resource type="Script" path="res://scripts/player/player_camera.gd" id="3_camera"]

[sub_resource type="CapsuleShape3D" id="Shape_body"]
radius = 0.4
height = 1.8

[sub_resource type="StandardMaterial3D" id="Material_body"]
albedo_color = Color(0.7, 0.7, 0.7, 1)

[sub_resource type="CapsuleMesh" id="Mesh_body"]
material = SubResource("Material_body")
radius = 0.4
height = 1.8

[sub_resource type="StandardMaterial3D" id="Material_nose"]
albedo_color = Color(0.25, 0.25, 0.25, 1)

[sub_resource type="BoxMesh" id="Mesh_nose"]
material = SubResource("Material_nose")
size = Vector3(0.2, 0.2, 0.3)

[sub_resource type="SphereShape3D" id="Shape_camera"]
radius = 0.2

[sub_resource type="SceneReplicationConfig" id="Replication_server"]
properties/0/path = NodePath(".:position")
properties/0/spawn = true
properties/0/replication_mode = 0
properties/1/path = NodePath(".:rotation")
properties/1/spawn = true
properties/1/replication_mode = 0
properties/2/path = NodePath(".:race_id")
properties/2/spawn = true
properties/2/replication_mode = 0
properties/3/path = NodePath(".:gender")
properties/3/spawn = true
properties/3/replication_mode = 0
properties/4/path = NodePath(".:class_id")
properties/4/spawn = true
properties/4/replication_mode = 0
properties/5/path = NodePath(".:display_name")
properties/5/spawn = true
properties/5/replication_mode = 2
properties/6/path = NodePath(".:level")
properties/6/spawn = true
properties/6/replication_mode = 2

[sub_resource type="SceneReplicationConfig" id="Replication_movement"]
properties/0/path = NodePath(".:net_time")
properties/0/spawn = false
properties/0/replication_mode = 1
properties/1/path = NodePath(".:net_position")
properties/1/spawn = false
properties/1/replication_mode = 1
properties/2/path = NodePath(".:net_yaw")
properties/2/spawn = false
properties/2/replication_mode = 1
properties/3/path = NodePath(".:net_state")
properties/3/spawn = false
properties/3/replication_mode = 1
properties/4/path = NodePath(".:net_teleport_seq")
properties/4/spawn = false
properties/4/replication_mode = 1

[node name="Player" type="CharacterBody3D"]
collision_layer = 2
collision_mask = 5
script = ExtResource("1_player")

[node name="Collision" type="CollisionShape3D" parent="."]
position = Vector3(0, 0.9, 0)
shape = SubResource("Shape_body")

[node name="Model" type="Node3D" parent="."]

[node name="Body" type="MeshInstance3D" parent="Model"]
position = Vector3(0, 0.9, 0)
mesh = SubResource("Mesh_body")

[node name="Nose" type="MeshInstance3D" parent="Model"]
position = Vector3(0, 1.4, -0.45)
mesh = SubResource("Mesh_nose")

[node name="Nameplate" type="Node3D" parent="."]
position = Vector3(0, 2.1, 0)

[node name="NameLabel" type="Label3D" parent="Nameplate"]
position = Vector3(0, 0.32, 0)
visibility_range_end = 80.0
pixel_size = 0.01
billboard = 1
text = "Name"
font_size = 40
outline_size = 10

[node name="LevelLabel" type="Label3D" parent="Nameplate"]
visibility_range_end = 80.0
pixel_size = 0.01
billboard = 1
text = "Stufe 1"
font_size = 26
outline_size = 8

[node name="CameraRig" type="Node3D" parent="."]
top_level = true
script = ExtResource("3_camera")

[node name="SpringArm" type="SpringArm3D" parent="CameraRig"]
collision_mask = 1
shape = SubResource("Shape_camera")
spring_length = 6.0

[node name="Camera" type="Camera3D" parent="CameraRig/SpringArm"]
near = 0.05
far = 500.0

[node name="PlayerInput" type="Node" parent="." node_paths=PackedStringArray("camera")]
script = ExtResource("2_input")
camera = NodePath("../CameraRig")

[node name="ServerSync" type="MultiplayerSynchronizer" parent="."]
root_path = NodePath("..")
replication_config = SubResource("Replication_server")

[node name="MovementSync" type="MultiplayerSynchronizer" parent="."]
root_path = NodePath("..")
replication_interval = 0.05
replication_config = SubResource("Replication_movement")
