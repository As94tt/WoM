[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/level_up_banner.gd" id="1_levelup"]

[node name="LevelUpBanner" type="VBoxContainer"]
anchors_preset = -1
anchor_top = 0.3
anchor_right = 1.0
anchor_bottom = 0.3
grow_horizontal = 2
mouse_filter = 2
