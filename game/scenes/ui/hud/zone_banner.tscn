[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/zone_banner.gd" id="1_banner"]

[node name="ZoneBanner" type="VBoxContainer"]
anchors_preset = 10
anchor_right = 1.0
offset_top = 160.0
offset_bottom = 250.0
grow_horizontal = 2
mouse_filter = 2
script = ExtResource("1_banner")

[node name="TitleLabel" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"ZoneBannerTitle"
text = "Gebietsname"
horizontal_alignment = 1

[node name="SubtitleLabel" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"ZoneBannerSubtitle"
text = "Stufe 1–3"
horizontal_alignment = 1
