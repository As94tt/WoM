text = "Ein Mitspieler kann Euch aufhelfen."
horizontal_alignment = 1
autowrap_mode = 3

[node name="OfferBox" type="VBoxContainer" parent="Content"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"ButtonList"

[node name="OfferLabel" type="Label" parent="Content/OfferBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"BodyText"
text = "X möchte Euch aufhelfen."
horizontal_alignment = 1
autowrap_mode = 3

[node name="OfferButtons" type="HBoxContainer" parent="Content/OfferBox"]
