[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/death_window.gd" id="1_death"]

[node name="DeathWindow" type="PanelContainer"]
visible = false
custom_minimum_size = Vector2(440, 0)
anchors_preset = 5
anchor_left = 0.5
anchor_right = 0.5
offset_left = -220.0
offset_top = 260.0
offset_right = 220.0
offset_bottom = 260.0
grow_horizontal = 2
theme_type_variation = &"DialogPanel"
script = ExtResource("1_death")

[node name="Content" type="VBoxContainer" parent="."]
layout_mode = 2
theme_type_variation = &"ButtonList"

[node name="TitleLabel" type="Label" parent="Content"]
layout_mode = 2
theme_type_variation = &"WindowTitle"
text = "Ihr seid gestorben"
horizontal_alignment = 1

[node name="InfoLabel" type="Label" parent="Content"]
unique_name_in_owner = true
layout_mode = 2
