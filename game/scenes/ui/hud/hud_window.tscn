[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/hud_window.gd" id="1_window"]

[node name="HudWindow" type="PanelContainer"]
custom_minimum_size = Vector2(400, 520)
script = ExtResource("1_window")

[node name="Rows" type="VBoxContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"ButtonList"

[node name="Header" type="HBoxContainer" parent="Rows"]
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"InlineRow"

[node name="TitleLabel" type="Label" parent="Rows/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"WindowTitle"
text = "Fenster"
vertical_alignment = 1
text_overrun_behavior = 3

[node name="CloseButton" type="Button" parent="Rows/Header"]
unique_name_in_owner = true
custom_minimum_size = Vector2(40, 40)
layout_mode = 2
tooltip_text = "Schließen"
focus_mode = 0
theme_type_variation = &"SlotButton"
text = "X"

[node name="ContentArea" type="MarginContainer" parent="Rows"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
mouse_filter = 2

[node name="Placeholder" type="Label" parent="Rows/ContentArea"]
layout_mode = 2
theme_type_variation = &"HintText"
text = "Kommt bald"
horizontal_alignment = 1
vertical_alignment = 1
